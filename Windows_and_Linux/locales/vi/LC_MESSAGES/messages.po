"This will permanently remove ALL {0} current command(s) (including System commands) and replace them with {1} command(s) from the backup.\n"
"\n"
"This cannot be undone. Are you sure?"
msgstr ""
"Thao tác này sẽ xóa vĩnh viễn TẤT CẢ {0} lệnh hiện có (kể cả lệnh hệ thống) và thay bằng {1} lệnh từ bản sao lưu.\n"
"\n"
"Không thể hoàn tác. Bạn có chắc không?"

msgid "All commands replaced with {0} command(s) from backup."
msgstr "Đã thay thế tất cả lệnh bằng {0} lệnh từ bản sao lưu."

msgid ""
"\"{0}\" is already used by command \"{1}\".\n"
"Please choose a different shortcut."
msgstr ""
"\"{0}\" đã được lệnh \"{1}\" sử dụng.\n"
"Vui lòng chọn phím tắt khác."

msgid "e.g. Ctrl+Shift+P"
msgstr "ví dụ: Ctrl+Shift+P"

msgid "Clear shortcut"
msgstr "Xóa phím tắt"

msgid ""
"Invalid shortcut format.\n"
"Use: Modifier+Key (e.g. Ctrl+Shift+P)\n"
"Modifiers: Ctrl, Shift, Alt, Super/Win\n"
"Keys: letters, digits, F1–F12, or special keys"
msgstr ""
"Định dạng phím tắt không hợp lệ.\n"
"Dùng: Phím bổ trợ+Phím (ví dụ Ctrl+Shift+P)\n"
"Phím bổ trợ: Ctrl, Shift, Alt, Super/Win\n"
"Phím: chữ cái, chữ số, F1–F12 hoặc phím đặc biệt"
